{% extends '@admin/default_frame.twig' %}

{% set menus = ['store', 'plugin', 'plugin_list'] %}

{% block title %}{{ 'blokbay_payment.admin.title'|trans }}{% endblock %}
{% block sub_title %}{{ 'blokbay_payment.admin.sub_title'|trans }}{% endblock %}

{% form_theme form '@admin/Form/bootstrap_4_horizontal_layout.html.twig' %}

{% block main %}
    <form role="form" method="post">
        {{ form_widget(form._token) }}
        <div class="c-contentsArea__cols">
            <div class="c-contentsArea__primaryCol">
                <div class="c-primaryCol">
                    {% if not usd %}
                        <div class="alert alert-danger" id="blokbay-currency-warning" role="alert">
                            {{ 'blokbay_payment.admin.usd_required'|trans({'%currency%': currency}) }}
                        </div>
                    {% endif %}
                    <div class="card rounded border-0 mb-4">
                        <div class="card-header"><span>{{ 'blokbay_payment.admin.keys'|trans }}</span></div>
                        <div class="card-body">
                            <p class="text-muted">{{ 'blokbay_payment.admin.keys_help'|trans }}</p>
                            <div class="row mb-2">
                                <div class="col-3"><span>{{ 'blokbay_payment.admin.secret_key'|trans }}</span></div>
                                <div class="col">
                                    {{ form_widget(form.secret_key) }}
                                    {{ form_errors(form.secret_key) }}
                                    <small class="text-muted">{{ has_secret ? 'blokbay_payment.admin.saved_keep'|trans : 'blokbay_payment.admin.not_saved'|trans }}</small>
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-3"><span>{{ 'blokbay_payment.admin.public_key'|trans }}</span></div>
                                <div class="col">
                                    {{ form_widget(form.public_key) }}
                                    {{ form_errors(form.public_key) }}
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-3"><span>{{ 'blokbay_payment.admin.webhook_secret'|trans }}</span></div>
                                <div class="col">
                                    {{ form_widget(form.webhook_secret) }}
                                    {{ form_errors(form.webhook_secret) }}
                                    <small class="text-muted">{{ has_webhook ? 'blokbay_payment.admin.saved_keep'|trans : 'blokbay_payment.admin.not_saved'|trans }}</small>
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-3"><span>{{ 'blokbay_payment.admin.api_base'|trans }}</span></div>
                                <div class="col">
                                    {{ form_widget(form.api_base) }}
                                    {{ form_errors(form.api_base) }}
                                    <small class="text-muted">{{ 'blokbay_payment.admin.api_base_help'|trans }}</small>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card rounded border-0 mb-4">
                        <div class="card-header"><span>{{ 'blokbay_payment.admin.webhook'|trans }}</span></div>
                        <div class="card-body">
                            <p>{{ 'blokbay_payment.admin.webhook_help'|trans }}</p>
                            <p><code dir="ltr" id="blokbay-webhook-url">{{ webhook_url }}</code></p>
                            <p class="text-muted">{{ 'blokbay_payment.admin.events'|trans }}</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="c-conversionArea">
            <div class="c-conversionArea__container">
                <div class="row justify-content-between align-items-center">
                    <div class="col-6">
                        <div class="c-conversionArea__leftBlockItem">
                            <a class="c-baseLink" href="{{ url('admin_store_plugin') }}">
                                <i class="fa fa-backward" aria-hidden="true"></i>
                                <span>{{ 'blokbay_payment.admin.back'|trans }}</span>
                            </a>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="row align-items-center justify-content-end">
                            <div class="col-auto">
                                <button class="btn btn-ec-conversion px-5" type="submit">{{ 'blokbay_payment.admin.save'|trans }}</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
{% endblock %}
